{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameView",
  "version": "0.1.0",
  "identifier": "com.frameview.app",
  "build": {
    "beforeDevCommand": "npm run setup:native && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run setup:native && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameView",
        "width": 1280,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffprobe"
    ],
    "resources": {
      "lib/libmpv-2.dll": "libmpv-2.dll",
      "lib/libmpv-wrapper.dll": "libmpv-wrapper.dll",
      "lib/LICENSE": "licenses/libmpv-LICENSE.txt",
      "lib/FFmpeg-LICENSE.txt": "licenses/FFmpeg-LICENSE.txt",
      "lib/THIRD-PARTY.md": "licenses/THIRD-PARTY.md"
    },
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "avi", "mov", "webm", "flv", "wmv", "m4v", "ts", "mts", "m2ts", "vob"],
        "name": "Video File",
        "description": "Video File handled by FrameView",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "Microsoft.WebView2.FixedVersionRuntime.157.0.4341.57.x64"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
